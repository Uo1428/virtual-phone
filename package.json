{
  "name": "virtual-phone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "shared", "server", "web"],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run --cwd web build",
    "start": "bun run server/src/index.ts",
    "typecheck": "tsc -p shared/tsconfig.json --noEmit && tsc -p packages/ui/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "bun test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bun": "latest",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
