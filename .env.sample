# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
TELNYX_API_KEY=
# Required in production: verifies incoming webhook signatures.
TELNYX_PUBLIC_KEY=
# Only set true if a proxy already verifies webhooks; otherwise prod rejects unverified ones.
TELNYX_ALLOW_UNVERIFIED_WEBHOOKS=false
PORT=3000
PUBLIC_URL=
SESSION_SECRET=
# Optional gate for /api/auth/login
APP_PASSCODE=
DATA_DIR=server/data
# Optional pins - discovery fills these automatically when empty
TELNYX_CALL_CONTROL_APP_ID=
TELNYX_CREDENTIAL_CONNECTION_ID=
TELNYX_OUTBOUND_VOICE_PROFILE_ID=
# Optional names used when provisioning new resources
TELNYX_CALL_CONTROL_APP_NAME=virtual-phone
TELNYX_CREDENTIAL_CONNECTION_NAME=virtual-phone-webrtc
TELNYX_OUTBOUND_PROFILE_NAME=virtual-phone-outbound
# Set to true to auto-create the call control app / credential connection when missing
TELNYX_PROVISION=true
